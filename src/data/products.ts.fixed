  // === PEPPLUS ===
    {
    id: "pepplus-moisture-sun-gel",
    name: "Pepplus+ Moisture Sun Gel SPF50+ PA++++ 50ml",
    shortDescription: `Lengvos tekstūros, drėkinantis veido gelis, užtikrinantis itin aukštą apsaugą nuo saulės ir papildomą odos priežiūrą.`,
    descriptionHtml: `<div><h3>Aprašymas</h3><p>PEPPLUS+ Moisture Sun Gel SPF50+ PA++++ – tai lengvos tekstūros, drėkinantis veido gelis, užtikrinantis itin aukštą apsaugą nuo saulės ir papildomą odos priežiūrą. Šis produktas sukurtas siekiant apsaugoti odą nuo žalingų saulės spindulių, tuo pačiu metu ją drėkinant ir gerinant jos išvaizdą.</p><h4>Pagrindiniai privalumai:</h4><ul><li><strong>Aukšta apsauga nuo saulės:</strong> SPF50+ ir PA++++ apsauga padeda efektyviai apsaugoti odą nuo UVA ir UVB spindulių, mažinant saulės sukeliamą žalą.</li><li><strong>Trigubas poveikis:</strong> kremas ne tik saugo nuo saulės, bet ir padeda mažinti raukšles bei šviesina odą, suteikdamas jai sveiką ir spindinčią išvaizdą.</li><li><strong>Lengva tekstūra:</strong> vandens pagrindo gelio konsistencija lengvai pasiskirsto ant odos, greitai įsigeria ir nepalieka riebumo ar baltumo pojūčio.</li></ul></div>`,
    brand: "Pepplus+",
    category: "spf-apsauga",
    tags: ["SPF50","drėkinimas","apsauga"],
    price: 25.60,
    oldPrice: 32.00,
    image: "https://www.skinmatu.lt/wp-content/uploads/2026/02/AP-_1386.avif",
    featured: true
  }},
    {
    id: "pepplus-gentle-cleansing-foam",
    name: "Pepplus+ Gentle cleansing foam prausiklis, 150ml",
    shortDescription: `Švelnus kreminis prausiklis, skirtas kasdieniam odos valymui. Tinka visų tipų odai, įskaitant jautrią ir sausą.`,
    descriptionHtml: `<div><h3>Aprašymas</h3><p>Pepplus+ Gentle Cleansing Foam – tai švelnus kreminis veido prausiklis, skirtas kasdieniam odos valymui. Tinka visų tipų odai, įskaitant jautrią ir sausą. Efektyviai pašalina nešvarumus, makiažo likučius ir riebalų perteklių, išlaikydamas odos drėgmės balansą ir nepažeisdamas apsauginio barjero.</p><h4>Poveikis:</h4><ul><li>Švelniai, bet efektyviai valo odą, pašalina makiažą ir nešvarumus</li><li>Drėkina ir ramina odą, apsaugo nuo tempimo pojūčio po prausimosi</li><li>Sudėtyje esantys hialurono rūgštis, peptidai ir augaliniai ekstraktai palaiko odos barjerą ir apsaugo nuo išsausėjimo</li><li>Suteikia odai minkštumo ir gaivumo pojūtį</li></ul><h3>Naudojimas</h3><p>Išspauskite nedidelį kiekį prausiklio ant drėgnų delnų, suputokite ir tepkite ant drėgnos veido odos. Švelniai masažuokite, tuomet nuplaukite šiltu vandeniu. Naudokite ryte ir vakare.</p></div>`,
    brand: "Pepplus+",
